# Copie para .env e preencha. Gere segredos com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Fernet: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Opcionais
# IA: cada provedor entra na fila de modelos só se tiver chave. Modelo local: URL no formato da OpenAI.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=qwen2.5:7b
# Transcrição: local (faster-whisper no worker, sem custo) ou openai (API no formato da OpenAI).
STT_PROVIDER=local
LOCAL_WHISPER_MODEL=base
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Asaas (cobrança). Sem chave, fora de produção, a cobrança roda em modo simulado.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Token que você define no painel do Asaas para os webhooks (cabeçalho asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
TRIAL_PLAN_ID=pro
TRIAL_DAYS=7
BILLING_GRACE_DAYS=5
# Contas de teste locais: cd apps/api && uv run python -m clipo_api.seed
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Entrar com Google: Google Cloud Console > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento: http://localhost:3200/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Entrar com Apple: Services ID, Team ID, Key ID e o conteúdo da chave .p8 numa linha (quebras como \n)
# A Apple exige HTTPS: use um túnel (ex.: Cloudflare Tunnel) e cadastre o domínio na Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Webhooks das redes: token que você define e cadastra no painel da Meta
META_WEBHOOK_VERIFY_TOKEN=

# Vercel (API como função serverless). Na Vercel, SERVERLESS liga sozinho (variável VERCEL).
# A fila anda em fatias: a tela chama /api/v1/jobs/pump e a tarefa diária chama /api/v1/internal/cron.
# SERVERLESS=true
# Segredo da tarefa agendada (a Vercel envia Authorization: Bearer CRON_SECRET)
# CRON_SECRET=
# Segundos de trabalho por chamada (deixe abaixo do limite de duração da função)
# WORKER_BUDGET_SECONDS=45
# Na Vercel não há faster-whisper: use STT_PROVIDER=openai
